{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "preserve",
    "checkJs": false,
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*", "scripts/**/*"],
  "exclude": ["node_modules", ".next"]
}
