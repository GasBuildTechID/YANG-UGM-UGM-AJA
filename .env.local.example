# ==============================================================================
# HEARME — ENVIRONMENT VARIABLES TEMPLATE (.env.local)
# ==============================================================================
# Panduan Cepat:
# 1. Duplikasi file ini dan ubah namanya menjadi `.env.local`:
#    - PowerShell / CMD : copy .env.local.example .env.local
#    - Bash / Terminal  : cp .env.local.example .env.local
# 2. Isi nilai variabel di bawah sesuai project Supabase & konfigurasi AI Anda.
# 3. PENTING: Jangan pernah melakukan commit file `.env.local` ke Git repository!
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. SUPABASE CONFIGURATION (Wajib)
# ------------------------------------------------------------------------------
# Dapatkan kredensial ini di:
# Supabase Dashboard -> Project Settings -> API (atau Project Settings -> Configuration -> Data API)

# URL Endpoint Proyek Supabase Anda
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# KUNCI PUBLIK (Client-Side / Aman ditampilkan di browser frontend)
# Catatan: Cukup isi salah satu dari dua opsi di bawah:
# - Dashboard Baru  : Gunakan Publishable Key (awalan `sb_publishable_...`)
# - Dashboard Lama  : Gunakan Anon Key (awalan `eyJ...`)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# KUNCI RAHASIA SERVER (Server-Side ONLY / Service Role)
# PERINGATAN: Kunci ini memiliki bypass RLS penuh!
# HANYA digunakan oleh backend server (scripts/seed.mjs dan app/api/support-request).
# JANGAN PERNAH diekspos ke browser atau di-commit ke Git.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ------------------------------------------------------------------------------
# 2. OPENAI CONFIGURATION (Opsional)
# ------------------------------------------------------------------------------
# Fitur ringkasan AI kebutuhan pengguna.
# Catatan: Jika OPENAI_API_KEY dibiarkan kosong, aplikasi otomatis beralih (fallback)
# ke sistem ringkasan berbasis aturan bawaan (rule-based) tanpa memerlukan API key.

# API Key dari platform OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Model OpenAI yang digunakan (rekomendasi: gpt-4o-mini untuk efisiensi & latensi rendah)
OPENAI_MODEL=gpt-4o-mini
