# ==============================================================================
# HEARME — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Salin file ini menjadi `.env.local` untuk development lokal, atau gunakan
# nama variabel ini untuk pengaturan Environment Variables di Vercel Dashboard.
# ==============================================================================

# 1. SUPABASE CONFIGURATION (Wajib)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. OPENAI CONFIGURATION (Opsional - fallback rule-based jika kosong)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

